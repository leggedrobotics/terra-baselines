# Local SSH alias configured for CSCS through Ela.
CSCS_SSH_TARGET=daint

# Current Slurm allocation. Override this when the project changes.
CSCS_ACCOUNT=d130

# Daint partitions are normal (24 h), low (24 h), and debug (30 min).
CSCS_PARTITION=normal

# Optional. The scripts otherwise use $SCRATCH/terra-training on the remote.
# CSCS_ROOT=/capstor/scratch/cscs/lterenzi/terra-training

# Runtime image produced by build_image.sh.
CSCS_IMAGE_NAME=terra-jax
CSCS_IMAGE_TAG=jax24.10-v1
CSCS_BASE_IMAGE=nvcr.io/nvidia/jax:24.10-py3

# W&B team used by Terra production runs. The smoke profile stays offline.
CSCS_WANDB_ENTITY=aless-weber-eth
